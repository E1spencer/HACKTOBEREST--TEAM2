# OPENROUTER_API_KEY: Optional/configurable API key for OpenRouter API (Google Gemma)
# Can also be set directly in the AI Assistant Settings modal in the app
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Google Gemma model via OpenRouter (e.g. google/gemma-2-9b-it, google/gemma-3-12b-it)
OPENROUTER_MODEL="google/gemma-2-9b-it"

# GEMINI_API_KEY: Fallback API key for Gemini / Generative Language OpenAI compatibility
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

